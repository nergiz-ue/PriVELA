# PriVELA site configuration — copy to `.env` and edit for your machine.
# `.env` is gitignored; this template is committed.

# --- MP-SPDZ ---------------------------------------------------------------
# Path to the MP-SPDZ installation (the dir containing compile.py and Scripts/).
# Distributed runs use the same value on every party host (a leading ~ is expanded there).
MP_SPDZ_PATH=~/mp-spdz

# --- Data ------------------------------------------------------------------
# Data root. `prepare-data` reads raw GPS data (GeoLife) from PRIVELA_DATA_DIR/raw.
PRIVELA_DATA_DIR=./data
# Prepared representations: `prepare-data` writes here and runs read from here.
# Leave blank to use PRIVELA_DATA_DIR/processed.
PRIVELA_PROCESSED_DIR=

# --- Execution defaults ----------------------------------------------------
DEFAULT_PROTOCOL=semi2k

# --- Distributed -----------------------------------------------------------
# Party hosts as "ip:user:party", comma-separated. The parties are the only machines that run
# MPC and hold shares; n-party protocols use the first n entries.
PRIVELA_HOSTS=10.0.0.3:mpc:0,10.0.0.4:mpc:1,10.0.0.5:mpc:2
# Coordinator's internal IP. Can be one of the party hosts or a separate machine that orchestrates execution and collects results.
PRIVELA_COORDINATOR_IP=10.0.0.5
# Base TCP port for MPC; protocols use [PORT_BASE, PORT_BASE+100].
PRIVELA_PORT_BASE=14000
# SSH key for passwordless intra-cluster access.
PRIVELA_SSH_KEY=~/.ssh/privela_key
# Remote repo path (identical clone on each party host).
PRIVELA_REMOTE_DIR=~/privela
