# ArgMinDist (UTM) -- index of the nearest candidate to the query point.
#
#   Party 0 : qx, qy                       (query, scaled UTM)
#   Party 1 : n, then MAX_C candidates (cx, cy)   (n is the secret valid count)
#   Output  : index of the closest candidate

import reduce

MAX_C = 20
INF = 10 ** 18

qx = sint.get_input_from(0)
qy = sint.get_input_from(0)
n = sint.get_input_from(1)
cx = Array(MAX_C, sint)
cy = Array(MAX_C, sint)
@for_range(MAX_C)
def _(i):
    cx[i] = sint.get_input_from(1)
    cy[i] = sint.get_input_from(1)

start_timer(1)
raw = Array(MAX_C, sint)
@for_range_opt(MAX_C)
def _(i):
    raw[i] = (qx - cx[i]) ** 2 + (qy - cy[i]) ** 2
d = reduce.masked(raw, n, INF)
result = reduce.argmin_index(d).reveal()
stop_timer(1)

print_ln("RESULT %s", result)
