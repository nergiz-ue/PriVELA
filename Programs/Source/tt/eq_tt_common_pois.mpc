# CommonPOIs (H3 / road, TT) -- how many public waypoints both trajectories visit.
#
#   Public  : NUM_W waypoint tokens (cells / nodes)
#   Party 0 : nA, then MAX_T tokens
#   Party 1 : nB, then MAX_T tokens
#   Output  : count of waypoints visited by both

import tt

MAX_T = 20
NUM_W = 5

W = [public_input() for _ in range(NUM_W)]

nA = sint.get_input_from(0)
a = Array(MAX_T, sint)
@for_range(MAX_T)
def _(i):
    a[i] = sint.get_input_from(0)
nB = sint.get_input_from(1)
b = Array(MAX_T, sint)
@for_range(MAX_T)
def _(j):
    b[j] = sint.get_input_from(1)

start_timer(1)
result = tt.common_count_eq(a, nA, b, nB, W).reveal()
stop_timer(1)

print_ln("RESULT %s", result)
