# CommonPOIs (UTM, TT) -- how many public waypoints both trajectories pass near (within R).
#
#   Public  : R^2 (scaled), then NUM_W waypoints (wx, wy)
#   Party 0 : nA, then MAX_T points (x, y)
#   Party 1 : nB, then MAX_T points (x, y)
#   Output  : count of waypoints visited (within R) by both

import tt

MAX_T = 20
NUM_W = 5

r2 = public_input()
W = [(public_input(), public_input()) for _ in range(NUM_W)]

nA = sint.get_input_from(0)
ax = Array(MAX_T, sint)
ay = Array(MAX_T, sint)
@for_range(MAX_T)
def _(i):
    ax[i] = sint.get_input_from(0)
    ay[i] = sint.get_input_from(0)
nB = sint.get_input_from(1)
bx = Array(MAX_T, sint)
by = Array(MAX_T, sint)
@for_range(MAX_T)
def _(j):
    bx[j] = sint.get_input_from(1)
    by[j] = sint.get_input_from(1)

start_timer(1)
result = tt.common_count_dist(ax, ay, nA, bx, by, nB, W, r2).reveal()
stop_timer(1)

print_ln("RESULT %s", result)
